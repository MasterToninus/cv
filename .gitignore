# Ignore output
gen
gen-*/
.venv/

# Ignore Python caches
__pycache__
*pyc
Pipfile.lock


# Bibliography inputs are source files; ignore only BibLaTeX's generated helper.
*-blx.bib

## Generated Template
tmpl/*.aux
tmpl/*.bbl
tmpl/*.blg
tmpl/*.fdb_latexmk
tmpl/*.fls
tmpl/*.log
tmpl/*.out
tmpl/*.pdf
tmpl/*.xml
tmpl/*.gz
tmpl/**.synctex*

## Log
.log

